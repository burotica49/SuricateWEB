# VigieWeb — configuration. Copiez ce fichier en « .env » et adaptez-le :
#     cp .env.example .env
# Le fichier .env n'est jamais versionné ni copié dans l'image Docker.
# Les variables d'environnement déjà définies (Docker, Dokploy…) ont priorité sur ce fichier.

# ── Connexion (OBLIGATOIRE : VigieWeb refuse de démarrer sans mot de passe) ──
VIGIE_USER=admin
# 8 caractères minimum. Entre guillemets si le mot de passe contient # ou des espaces.
# Générer un mot de passe :  node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
VIGIE_PASSWORD=

# ── Serveur (optionnel) ──
# PORT=3000
# HOST=127.0.0.1            # 0.0.0.0 pour écouter sur toutes les interfaces
# DATA_DIR=./data           # base SQLite et captures d'écran
# TRUST_PROXY=1             # derrière un reverse proxy (Traefik, nginx) : cookie Secure et vraie IP client

# ── Garde réseau (optionnel) ──
# Interdit à VigieWeb d'atteindre le réseau interne de son serveur (SSRF) : adresses privées ou réservées, ports hors liste,
# redirections et DNS « rebinding » compris. À activer si VigieWeb est ouvert à des inconnus. Pour une installation personnelle,
# laissez désactivé : surveiller un site de votre réseau interne est alors légitime.
# VIGIE_NET_GUARD=1
# VIGIE_NET_ALLOW_PORTS=80,443,8080,8443        # « * » = tous les ports
# VIGIE_NET_ALLOW_HOSTS=intranet.exemple,10.0.0.5,10.1.0.0/16   # exceptions explicites

# ── Captures d'écran (optionnel) ──
# CHROME_PATH=/usr/bin/chromium   # détecté automatiquement si Chrome/Chromium/Edge/Brave est installé
# CHROME_NO_SANDBOX=1             # requis dans Docker (déjà défini dans l'image)
